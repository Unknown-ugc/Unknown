--// DRAG
local function MakeDraggable(Object)
	local Dragging = false
	local DragStart
	local StartPosition
	local WasDragged = false

	Object.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			WasDragged = false
			DragStart = Input.Position
			StartPosition = Object.Position

			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart

			if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then
				WasDragged = true
			end

			Object.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
		end
	end)

	return function()
		return WasDragged
	end
end

local MainDragged = MakeDraggable(Main)
local MiniDragged = MakeDraggable(Mini)

--// HIDE REAL CHARACTER
local function HideCharacter(Character)
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 1

		elseif Object:IsA("Decal") then
			Object.Transparency = 1
		end
	end
end

--// RESTORE REAL CHARACTER
local function RestoreCharacter(Character)
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 0

		elseif Object:IsA("Decal") then
			Object.Transparency = 0
		end
	end
end

--// MAKE VISUAL AVATAR NON-PHYSICAL
local function SetupVisualPart(Object)
	if Object:IsA("BasePart") then
		Object.CanCollide = false
		Object.CanTouch = false
		Object.CanQuery = false
		Object.Massless = true
		Object.CastShadow = false
	end
end

--// GET HUMANOID
local function GetHumanoid(Model)
	if not Model then
		return nil
	end

	return Model:FindFirstChildOfClass("Humanoid")
end

--// GET ANIMATOR
local function GetAnimator(Model)
	local Humanoid = GetHumanoid(Model)

	if not Humanoid then
		return nil
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	return Animator
end

--// STOP SYNCED TRACKS
local function StopSyncedTracks()
	for _, Track in pairs(SyncedTracks) do
		pcall(function()
			Track:Stop(0)
			Track:Destroy()
		end)
	end

	table.clear(SyncedTracks)
end

--// SYNC PLAYER ANIMATIONS
local function SyncAnimations()
	if not CurrentCharacter or not OverlayModel then
		return
	end

	local OriginalAnimator = GetAnimator(CurrentCharacter)
	local OverlayAnimator = GetAnimator(OverlayModel)

	if not OriginalAnimator or not OverlayAnimator then
		return
	end

	local PlayingTracks = OriginalAnimator:GetPlayingAnimationTracks()
	local ActiveAnimations = {}

	for _, OriginalTrack in ipairs(PlayingTracks) do
		local Animation = OriginalTrack.Animation

		if Animation and Animation.AnimationId ~= "" then
			local AnimationId = Animation.AnimationId

			ActiveAnimations[AnimationId] = true

			local OverlayTrack = SyncedTracks[AnimationId]

			--// CREATE TRACK
			if not OverlayTrack then
				local NewAnimation = Instance.new("Animation")
				NewAnimation.AnimationId = AnimationId

				local Success, Result = pcall(function()
					return OverlayAnimator:LoadAnimation(NewAnimation)
				end)

				NewAnimation:Destroy()

				if Success and Result then
					OverlayTrack = Result
					OverlayTrack.Priority = OriginalTrack.Priority
					OverlayTrack.Looped = OriginalTrack.Looped

					pcall(function()
						OverlayTrack:Play(0)
					end)

					SyncedTracks[AnimationId] = OverlayTrack
				end
			end

			--// SYNC EXISTING TRACK
			if OverlayTrack then
				pcall(function()
					OverlayTrack.Priority = OriginalTrack.Priority
					OverlayTrack.Looped = OriginalTrack.Looped
					OverlayTrack:AdjustSpeed(OriginalTrack.Speed)

					local Difference =
						math.abs(OverlayTrack.TimePosition - OriginalTrack.TimePosition)

					if Difference > 0.08 then
						OverlayTrack.TimePosition = OriginalTrack.TimePosition
					end
				end)
			end
		end
	end

	--// REMOVE OLD TRACKS
	for AnimationId, Track in pairs(SyncedTracks) do
		if not ActiveAnimations[AnimationId] then
			pcall(function()
				Track:Stop(0.1)
				Track:Destroy()
			end)

			SyncedTracks[AnimationId] = nil
		end
	end
end

--// REMOVE AVATAR
local function RemoveAvatar()
	if AnimationConnection then
		AnimationConnection:Disconnect()
		AnimationConnection = nil
	end

	StopSyncedTracks()

	if OverlayModel then
		OverlayModel:Destroy()
		OverlayModel = nil
	end

	if CurrentCharacter then
		RestoreCharacter(CurrentCharacter)
	end
end

--// CHANGE AVATAR
local function ChangeAvatar()
	local Username = UsernameBox.Text

	if Username == "" then
		return
	end

	local Success, UserId = pcall(function()
		return Players:GetUserIdFromNameAsync(Username)
	end)

	if not Success or not UserId then
		UsernameBox.Text = ""
		UsernameBox.PlaceholderText = "Username not found"
		return
	end

	local Character = LocalPlayer.Character

	if not Character then
		return
	end

	--// REMOVE OLD REPLACEMENT FIRST
	RemoveAvatar()

	CurrentCharacter = Character

	--// CREATE AVATAR
	local ModelSuccess, NewModel = pcall(function()
		return Players:CreateHumanoidModelFromUserIdAsync(UserId)
	end)

	if not ModelSuccess or not NewModel then
		UsernameBox.PlaceholderText = "Avatar failed"
		return
	end

	OverlayModel = NewModel
	OverlayModel.Name = "ChrisAvatarVisual"

	--// REMOVE UNNEEDED SCRIPTS
	for _, Object in ipairs(OverlayModel:GetDescendants()) do
		if Object:IsA("Script")
			or Object:IsA("LocalScript")
			or Object:IsA("ModuleScript") then

			Object:Destroy()
		end
	end

	--// MAKE EVERYTHING VISUAL ONLY
	for _, Object in ipairs(OverlayModel:GetDescendants()) do
		SetupVisualPart(Object)
	end

	--// PARENT TO CAMERA
	OverlayModel.Parent = workspace.CurrentCamera

	--// INITIAL POSITION
	pcall(function()
		OverlayModel:PivotTo(Character:GetPivot())
	end)

	--// HIDE REAL AVATAR
	HideCharacter(Character)

	--// CREATE ANIMATION CONNECTION
	AnimationConnection = RunService.RenderStepped:Connect(function()
		if not Character
			or not Character.Parent
			or not OverlayModel
			or not OverlayModel.Parent then
			return
		end

		--// FOLLOW REAL PLAYER EXACTLY
		pcall(function()
			OverlayModel:PivotTo(Character:GetPivot())
		end)

		--// SYNC CURRENT ANIMATION
		SyncAnimations()
	end)

	--// INITIAL ANIMATION SYNC
	task.defer(function()
		if OverlayModel and CurrentCharacter then
			SyncAnimations()
		end
	end)
end

