--========================================================
-- DRAGGING
--========================================================

local function makeDraggable(object)

    local dragging = false
    local dragStart
    local startPosition
    local moved = false

    object.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            moved = false
            dragStart = input.Position
            startPosition = object.Position

            input.Changed:Connect(function()

                if input.UserInputState ==
                    Enum.UserInputState.End then

                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            local delta =
                input.Position - dragStart

            if math.abs(delta.X) > 4
                or math.abs(delta.Y) > 4 then

                moved = true
            end

            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    return function()
        return moved
    end
end

local MainWasDragged = makeDraggable(Main)
local MiniWasDragged = makeDraggable(Mini)

--========================================================
-- CHARACTER
--========================================================

local function getCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP(character)

    return character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )
end

--========================================================
-- OVERLAY FOLDER
--========================================================

local function getOverlayFolder()

    local camera = workspace.CurrentCamera

    if not camera then
        return nil
    end

    local folder =
        camera:FindFirstChild(
            "_ChrisAvatarOverlay"
        )

    if not folder then

        folder = Instance.new("Folder")
        folder.Name = "_ChrisAvatarOverlay"
        folder.Parent = camera
    end

    return folder
end

--========================================================
-- STOP MIRROR
--========================================================

local function stopMirror()

    if Overlay.renderConn then

        Overlay.renderConn:Disconnect()
        Overlay.renderConn = nil
    end
end

--========================================================
-- CLEAR MOTOR PAIRS
--========================================================

local function clearMotorPairs()

    table.clear(
        Overlay.motorPairs
    )
end

--========================================================
-- RESTORE REAL AVATAR
--========================================================

local function restoreRealAvatar()

    for instance, oldTransparency
        in pairs(Overlay.hiddenParts) do

        if instance
            and instance.Parent then

            if instance:IsA("BasePart") then

                instance.LocalTransparencyModifier =
                    oldTransparency

            elseif instance:IsA("Decal")
                or instance:IsA("Texture") then

                instance.Transparency =
                    oldTransparency
            end
        end
    end

    table.clear(
        Overlay.hiddenParts
    )
end

--========================================================
-- HIDE REAL AVATAR
--========================================================

local function hideRealAvatar(character)

    if not character then
        return
    end

    table.clear(
        Overlay.hiddenParts
    )

    for _, instance in ipairs(
        character:GetDescendants()
    ) do

        if instance:IsA("BasePart") then

            Overlay.hiddenParts[instance] =
                instance.LocalTransparencyModifier

            instance.LocalTransparencyModifier = 1

        elseif instance:IsA("Decal")
            or instance:IsA("Texture") then

            Overlay.hiddenParts[instance] =
                instance.Transparency

            instance.Transparency = 1
        end
    end
end

--========================================================
-- PREPARE VISUAL AVATAR
--========================================================

local function prepareModel(model)

    for _, instance in ipairs(
        model:GetDescendants()
    ) do

        if instance:IsA("Script")
            or instance:IsA("LocalScript")
            or instance:IsA("ModuleScript") then

            pcall(function()
                instance:Destroy()
            end)

        elseif instance:IsA("BasePart") then

            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.Massless = true
        end
    end

    local humanoid =
        model:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid then

        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        humanoid.Sit = true

        pcall(function()
            humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Physics,
                false
            )
        end)
    end
end

--========================================================
-- MOTOR KEY
--========================================================

local function motorKey(motor)

    local part0 =
        motor.Part0
        and motor.Part0.Name
        or ""

    local part1 =
        motor.Part1
        and motor.Part1.Name
        or ""

    return motor.Name
        .. "|"
        .. part0
        .. ">"
        .. part1
end

--========================================================
-- BUILD MOTOR PAIRS
-- EXACT + FALLBACK MATCHING
--========================================================

local function buildMotorPairs(
    sourceCharacter,
    targetModel
)

    clearMotorPairs()

    local sourceByKey = {}
    local targetByKey = {}

    local sourceByName = {}
    local targetByName = {}

    -- REAL CHARACTER
    for _, instance in ipairs(
        sourceCharacter:GetDescendants()
    ) do

        if instance:IsA("Motor6D") then

            sourceByKey[
                motorKey(instance)
            ] = instance

            if not sourceByName[instance.Name] then

                sourceByName[instance.Name] =
                    instance
            end
        end
    end

    -- VISUAL AVATAR
    for _, instance in ipairs(
        targetModel:GetDescendants()
    ) do

        if instance:IsA("Motor6D") then

            targetByKey[
                motorKey(instance)
            ] = instance

            if not targetByName[instance.Name] then

                targetByName[instance.Name] =
                    instance
            end
        end
    end

    local matched = {}

    --====================================================
    -- FIRST: EXACT MATCH
    --====================================================

    for key, sourceMotor
        in pairs(sourceByKey) do

        local targetMotor =
            targetByKey[key]

        if targetMotor then

            table.insert(
                Overlay.motorPairs,
                {
                    src = sourceMotor,
                    tgt = targetMotor
                }
            )

            matched[targetMotor] = true
        end
    end

    --====================================================
    -- SECOND: NAME MATCH FALLBACK
    --====================================================

    for name, sourceMotor
        in pairs(sourceByName) do

        local targetMotor =
            targetByName[name]

        if targetMotor
            and not matched[targetMotor] then

            table.insert(
                Overlay.motorPairs,
                {
                    src = sourceMotor,
                    tgt = targetMotor
                }
            )

            matched[targetMotor] = true
        end
    end
end

--========================================================
-- START MOVEMENT + ANIMATION MIRROR
--========================================================

local function startMirror()

    stopMirror()

    Overlay.renderConn =
        RunService.RenderStepped:Connect(
        function()

            local visual =
                Overlay.model

            local visualHRP =
                Overlay.hrp

            if not visual
                or not visualHRP
                or not visual.Parent
                or not visualHRP.Parent then

                return
            end

            local realCharacter =
                getCharacter()

            local realHRP =
                getHRP(realCharacter)

            if not realHRP then
                return
            end

            --================================================
            -- ROOT MOVEMENT
            --
            -- The WeldConstraint normally keeps the visual
            -- attached to the real character.
            --
            -- This fallback corrects the root if Roblox
            -- separates the visual model.
            --================================================

            if (visualHRP.Position -
                realHRP.Position).Magnitude > 0.05 then

                visual:PivotTo(
                    realHRP.CFrame
                )
            end

            --================================================
            -- ANIMATION / BODY POSE
            --================================================

            for _, pair in ipairs(
                Overlay.motorPairs
            ) do

                local source =
                    pair.src

                local target =
                    pair.tgt

                if source
                    and target
                    and source.Parent
                    and target.Parent then

                    target.Transform =
                        source.Transform
                end
            end
        end
    )
end

--========================================================
-- REMOVE AVATAR
--========================================================

local function removeAvatar()

    -- Stop movement/animation mirror
    stopMirror()

    -- Remove motor references
    clearMotorPairs()

    -- Destroy visual
    if Overlay.model then

        pcall(function()
            Overlay.model:Destroy()
        end)
    end

    Overlay.model = nil
    Overlay.hrp = nil
    Overlay.weld = nil

    -- Restore original avatar
    restoreRealAvatar()

    Overlay.lastUserId = nil
    Overlay.lastUsername = nil
end

--========================================================
-- CHANGE AVATAR
--========================================================

local function changeAvatar(username)

    if Busy then
        return false, "Please wait..."
    end

    username =
        tostring(username or "")

    username =
        username:gsub(
            "^%s+",
            ""
        )

    username =
        username:gsub(
            "%s+$",
            ""
        )

    if username == "" then

        return false,
            "Enter username."
    end

    Busy = true

    -- Remove previous visual
    removeAvatar()

    local realCharacter =
        getCharacter()

    local realHRP =
        getHRP(realCharacter)

    if not realHRP then

        Busy = false

        return false,
            "Character not ready."
    end

    --====================================================
    -- GET USER ID
    --====================================================

    local userSuccess, userId =
        pcall(function()

            return Players:
                GetUserIdFromNameAsync(
                    username
                )
        end)

    if not userSuccess
        or not userId then

        Busy = false

        return false,
            "Username not found."
    end

    --====================================================
    -- CREATE ROBLOX AVATAR MODEL
    --====================================================

    local modelSuccess,
        targetModel =
        pcall(function()

            return Players:
                CreateHumanoidModelFromUserIdAsync(
                    userId
                )
        end)

    if not modelSuccess
        or not targetModel then

        Busy = false

        return false,
            "Failed to load avatar."
    end

    --====================================================
    -- PREPARE MODEL
    --====================================================

    prepareModel(
        targetModel
    )

    targetModel.Name =
        "ChrisAvatarOverlay"

    --====================================================
    -- FOLDER
--====================================================

    local folder =
        getOverlayFolder()

    if not folder then

        targetModel:Destroy()

        Busy = false

        return false,
            "Camera not ready."
    end

    targetModel.Parent =
        folder

    --====================================================
    -- VISUAL ROOT
    --====================================================

    local targetHRP =
        targetModel:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then

        targetModel:Destroy()

        Busy = false

        return false,
            "Avatar has no HumanoidRootPart."
    end

    --====================================================
    -- INITIAL POSITION
    --====================================================

    targetModel:PivotTo(
        realHRP.CFrame
    )

    --====================================================
    -- WELD VISUAL TO REAL CHARACTER
    --====================================================

    local weld =
        Instance.new(
            "WeldConstraint"
        )

    weld.Name =
        "ChrisAvatarWeld"

    weld.Part0 =
        targetHRP

    weld.Part1 =
        realHRP

    weld.Parent =
        targetHRP

    --====================================================
    -- EXTRA ROOT PHYSICS
    --====================================================

    targetHRP.CanCollide = false
    targetHRP.CanTouch = false
    targetHRP.CanQuery = false
    targetHRP.Massless = true

    --====================================================
    -- SAVE STATE
    --====================================================

    Overlay.model =
        targetModel

    Overlay.hrp =
        targetHRP

    Overlay.weld =
        weld

    Overlay.lastUserId =
        userId

    Overlay.lastUsername =
        username

    --====================================================
    -- BUILD ANIMATION PAIRS
    --====================================================

    buildMotorPairs(
        realCharacter,
        targetModel
    )

    --====================================================
    -- START MOVEMENT + ANIMATION
    --====================================================

    startMirror()

    --====================================================
    -- HIDE REAL CHARACTER
    --====================================================

    hideRealAvatar(
        realCharacter
    )

    Busy = false

    return true,
        "Avatar changed: @" .. username
end

