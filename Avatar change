--==================================================
-- DRAGGING
--==================================================

local function MakeDraggable(Object)
	local Dragging = false
	local DragStart
	local StartPosition
	local WasDragged = false

	Object.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			WasDragged = false
			DragStart = Input.Position
			StartPosition = Object.Position

			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart

			if math.abs(Delta.X) > 4 or math.abs(Delta.Y) > 4 then
				WasDragged = true
			end

			Object.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
		end
	end)

	return function()
		return WasDragged
	end
end

local MainDragged = MakeDraggable(Main)
local MiniDragged = MakeDraggable(Mini)

--==================================================
-- HIDE REAL CHARACTER
--==================================================

local function HideRealCharacter(Character)
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do

		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 1

		elseif Object:IsA("Decal") then
			Object.LocalTransparencyModifier = 1
		end
	end
end

--==================================================
-- RESTORE REAL CHARACTER
--==================================================

local function RestoreRealCharacter(Character)
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do

		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 0

		elseif Object:IsA("Decal") then
			Object.LocalTransparencyModifier = 0
			Object.Transparency = 0
		end
	end
end

--==================================================
-- MAKE VISUAL AVATAR NON-PHYSICAL
--==================================================

local function MakeVisualOnly(Object)

	if Object:IsA("BasePart") then
		Object.CanCollide = false
		Object.CanTouch = false
		Object.CanQuery = false
		Object.Massless = true
		Object.CastShadow = false
	end

	-- Remove scripts so the visual model
	-- cannot run its own behavior.
	if Object:IsA("Script")
		or Object:IsA("LocalScript")
		or Object:IsA("ModuleScript") then

		Object:Destroy()
	end
end

--==================================================
-- REMOVE VISUAL AVATAR
--==================================================

local function RemoveAvatar()

	-- STOP FOLLOW LOOP FIRST
	if RenderConnection then
		RenderConnection:Disconnect()
		RenderConnection = nil
	end

	-- DESTROY VISUAL AVATAR
	if VisualCharacter then
		VisualCharacter:Destroy()
		VisualCharacter = nil
	end

	-- RESTORE REAL AVATAR
	if RealCharacter then
		RestoreRealCharacter(RealCharacter)
	end

	-- CLEAR REFERENCE
	RealCharacter = LocalPlayer.Character
end

--==================================================
-- CHANGE AVATAR
--==================================================

local function ChangeAvatar()

	if IsChanging then
		return
	end

	IsChanging = true

	local Username = UsernameBox.Text

	if Username == "" then
		IsChanging = false
		return
	end

	local Character = LocalPlayer.Character

	if not Character then
		IsChanging = false
		return
	end

	-- REMOVE OLD VISUAL FIRST
	RemoveAvatar()

	RealCharacter = Character

	-- GET USER ID
	local Success, UserId = pcall(function()
		return Players:GetUserIdFromNameAsync(Username)
	end)

	if not Success or not UserId then
		UsernameBox.Text = ""
		UsernameBox.PlaceholderText = "Username not found"
		IsChanging = false
		return
	end

	-- CREATE VISUAL AVATAR
	local ModelSuccess, NewModel = pcall(function()
		return Players:CreateHumanoidModelFromUserIdAsync(UserId)
	end)

	if not ModelSuccess or not NewModel then
		UsernameBox.PlaceholderText = "Avatar failed"
		IsChanging = false
		return
	end

	VisualCharacter = NewModel
	VisualCharacter.Name = "ChrisVisualAvatar"

	-- MAKE EVERYTHING VISUAL ONLY
	for _, Object in ipairs(VisualCharacter:GetDescendants()) do
		MakeVisualOnly(Object)
	end

	-- PARENT TO CAMERA
	VisualCharacter.Parent = workspace.CurrentCamera

	-- POSITION EXACTLY ON REAL PLAYER
	pcall(function()
		VisualCharacter:PivotTo(RealCharacter:GetPivot())
	end)

	-- HIDE REAL PLAYER LOCALLY
	HideRealCharacter(RealCharacter)

	--==================================================
	-- FOLLOW ONLY
	-- NO SECOND MOVEMENT CONTROLLER
	--==================================================

	RenderConnection = RunService.RenderStepped:Connect(function()

		if not RealCharacter
			or not RealCharacter.Parent then

			RemoveAvatar()
			return
		end

		if not VisualCharacter
			or not VisualCharacter.Parent then

			return
		end

		-- FOLLOW REAL CHARACTER POSITION/ROTATION
		pcall(function()
			VisualCharacter:PivotTo(
				RealCharacter:GetPivot()
			)
		end)
	end)

	IsChanging = false
end

