--// Variables
local OverlayModel = nil
local RenderConnection = nil
local OriginalTransparency = {}

--// Save original avatar transparency
local function saveOriginalCharacter()
    OriginalTransparency = {}

    local character = LocalPlayer.Character
    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            OriginalTransparency[obj] = obj.LocalTransparencyModifier
        end
    end
end

--// Hide original avatar
local function hideOriginalCharacter()
    local character = LocalPlayer.Character
    if not character then
        return
    end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.LocalTransparencyModifier = 1
        end
    end
end

--// Restore original avatar
local function restoreOriginalCharacter()
    local character = LocalPlayer.Character

    if character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = OriginalTransparency[obj] or 0
            end
        end
    end

    OriginalTransparency = {}
end

--// Remove current overlay
local function removeAvatar()
    if RenderConnection then
        RenderConnection:Disconnect()
        RenderConnection = nil
    end

    if OverlayModel then
        OverlayModel:Destroy()
        OverlayModel = nil
    end

    restoreOriginalCharacter()

    Status.Text = "Original avatar restored"
end

--// Get player by username
local function getUserId(username)
    username = username:gsub("^%s+", ""):gsub("%s+$", "")

    if username == "" then
        return nil
    end

    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)

    if success then
        return userId
    end

    return nil
end

--// Build avatar
local function changeAvatar()
    local username = UsernameBox.Text

    if username == "" then
        Status.Text = "Enter a Roblox username"
        return
    end

    Status.Text = "Loading avatar..."

    local userId = getUserId(username)

    if not userId then
        Status.Text = "Username not found"
        return
    end

    removeAvatar()

    local success, model = pcall(function()
        return Players:CreateHumanoidModelFromUserIdAsync(userId)
    end)

    if not success or not model then
        Status.Text = "Could not load avatar"
        return
    end

    OverlayModel = model
    OverlayModel.Name = "_ChrisAvatarOverlay"

    local camera = workspace.CurrentCamera
    OverlayModel.Parent = camera

    local character = LocalPlayer.Character
    if not character then
        OverlayModel:Destroy()
        OverlayModel = nil
        Status.Text = "Character not found"
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local overlayRoot = OverlayModel:FindFirstChild("HumanoidRootPart")

    if not root or not overlayRoot then
        OverlayModel:Destroy()
        OverlayModel = nil
        Status.Text = "Avatar rig error"
        return
    end

    saveOriginalCharacter()

    -- Match position
    OverlayModel:PivotTo(root.CFrame)

    -- Hide original
    hideOriginalCharacter()

    -- Keep overlay attached to player
    RenderConnection = RunService.RenderStepped:Connect(function()
        if not OverlayModel or not OverlayModel.Parent then
            return
        end

        local currentCharacter = LocalPlayer.Character
        if not currentCharacter then
            return
        end

        local currentRoot = currentCharacter:FindFirstChild("HumanoidRootPart")
        if not currentRoot then
            return
        end

        OverlayModel:PivotTo(currentRoot.CFrame)
    end)

    Status.Text = "Avatar changed"
end

--// Buttons
ChangeButton.MouseButton1Click:Connect(changeAvatar)
RemoveButton.MouseButton1Click:Connect(removeAvatar)

--// Enter key
UsernameBox.FocusLost:Connect(function(enterPressed)
