	lastUsername = nil,
	hiddenParts = {}
}

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- OVERLAY FOLDER
--==================================================

local function getOverlayFolder()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	local folder = camera:FindFirstChild("_ChrisAvatarOverlay")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "_ChrisAvatarOverlay"
		folder.Parent = camera
	end

	return folder
end

--==================================================
-- STOP MIRROR
--==================================================

local function stopRender()
	if Overlay.renderConn then
		Overlay.renderConn:Disconnect()
		Overlay.renderConn = nil
	end
end

local function clearMotorPairs()
	table.clear(Overlay.motorPairs)
end

--==================================================
-- RESTORE REAL AVATAR
--==================================================

local function restoreRealAvatar()
	for instance, oldTransparency in pairs(Overlay.hiddenParts) do
		if instance and instance.Parent then
			if instance:IsA("BasePart") then
				instance.LocalTransparencyModifier = oldTransparency

			elseif instance:IsA("Decal") or instance:IsA("Texture") then
				instance.Transparency = oldTransparency
			end
		end
	end

	table.clear(Overlay.hiddenParts)
end

--==================================================
-- HIDE REAL AVATAR LOCALLY
--==================================================

local function hideRealAvatar(character)
	if not character then
		return
	end

	table.clear(Overlay.hiddenParts)

	for _, instance in ipairs(character:GetDescendants()) do

		if instance:IsA("BasePart") then
			if Overlay.hiddenParts[instance] == nil then
				Overlay.hiddenParts[instance] =
					instance.LocalTransparencyModifier
			end

			instance.LocalTransparencyModifier = 1

		elseif instance:IsA("Decal") or instance:IsA("Texture") then
			if Overlay.hiddenParts[instance] == nil then
				Overlay.hiddenParts[instance] =
					instance.Transparency
			end

			instance.Transparency = 1
		end
	end
end

--==================================================
-- PREPARE TARGET AVATAR
--==================================================

local function prepareModel(model)

	for _, instance in ipairs(model:GetDescendants()) do

		-- Prevent the target avatar from running its own scripts
		if instance:IsA("Script")
			or instance:IsA("LocalScript")
			or instance:IsA("ModuleScript") then

			instance:Destroy()

		elseif instance:IsA("BasePart") then

			instance.CanCollide = false
			instance.CanTouch = false
			instance.CanQuery = false
			instance.Massless = true
			instance.CastShadow = false
		end
	end

	-- Disable independent humanoid movement
	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
		humanoid.Sit = true

		humanoid:SetStateEnabled(
			Enum.HumanoidStateType.Physics,
			false
		)
	end

	return model
end

--==================================================
-- MOTOR KEY
--==================================================

local function motorKey(motor)

	local part0 =
		(motor.Part0 and motor.Part0.Name)
		or "nil"

	local part1 =
		(motor.Part1 and motor.Part1.Name)
		or "nil"

	return motor.Name .. "|" .. part0 .. ">" .. part1
end

--==================================================
-- BUILD MOTOR PAIRS
--==================================================

local function buildMotorPairs(sourceCharacter, targetModel)

	clearMotorPairs()

	local sourceMotors = {}
	local targetMotors = {}

	for _, instance in ipairs(sourceCharacter:GetDescendants()) do
		if instance:IsA("Motor6D") then
			sourceMotors[motorKey(instance)] = instance
		end
	end

	for _, instance in ipairs(targetModel:GetDescendants()) do
		if instance:IsA("Motor6D") then
			targetMotors[motorKey(instance)] = instance
		end
	end

	for key, sourceMotor in pairs(sourceMotors) do

		local targetMotor = targetMotors[key]

		if targetMotor then
			table.insert(
				Overlay.motorPairs,
				{
					src = sourceMotor,
					tgt = targetMotor
				}
			)
		end
	end
end

--==================================================
-- POSE MIRROR
--==================================================

local function startPoseMirror()

	stopRender()

	Overlay.renderConn =
		RunService.RenderStepped:Connect(function()

			if not Overlay.model
				or not Overlay.hrp then
				return
			end

			for _, pair in ipairs(Overlay.motorPairs) do

				local source = pair.src
				local target = pair.tgt

				if source
					and target
					and source.Parent
					and target.Parent then

					target.Transform = source.Transform
				end
			end
		end)
end

--==================================================
-- DESTROY AVATAR
--==================================================

local function destroyOverlay()

	-- Stop pose mirror FIRST
	stopRender()

	-- Stop motor references
	clearMotorPairs()

	-- Destroy visual avatar
	if Overlay.model then
		pcall(function()
			Overlay.model:Destroy()
		end)
	end

	Overlay.model = nil
	Overlay.hrp = nil
	Overlay.weld = nil

	-- IMPORTANT:
	-- Restore the REAL avatar
	restoreRealAvatar()

	Overlay.lastUserId = nil
	Overlay.lastUsername = nil
end

--==================================================
-- RESOLVE USERNAME
--==================================================

local function resolveUsername(text)

	text = tostring(text or "")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")

	if text == "" then
		return false, nil, "Enter a username."
	end

	local success, userId =
		pcall(function()
			return Players:GetUserIdFromNameAsync(text)
		end)

	if not success or not userId then
		return false, nil, "Username not found."
	end

	return true, userId, text
end

--==================================================
-- CHANGE AVATAR
--==================================================

local function changeAvatar(username)

	-- Remove previous avatar first
	destroyOverlay()

	local character = getCharacter()
	local realHRP = getHRP(character)

	if not realHRP then
		return false, "Your character is not ready."
	end

	-- Resolve username
	local success, userId, result =
		resolveUsername(username)

	if not success then
		return false, result
	end

	-- Create target avatar
	local modelSuccess, targetModel =
		pcall(function()
			return Players:CreateHumanoidModelFromUserIdAsync(userId)
		end)

	if not modelSuccess
		or typeof(targetModel) ~= "Instance" then

		return false, "Failed to create avatar."
	end

	-- Prepare visual model
	local model = prepareModel(targetModel)

	model.Name = "ChrisAvatarOverlay_" .. tostring(userId)

	-- Put model under camera
	local folder = getOverlayFolder()

	if not folder then
		model:Destroy()
		return false, "Camera not ready."
	end

	model.Parent = folder

	-- Target HRP
	local targetHRP =
		model:FindFirstChild("HumanoidRootPart")

	if not targetHRP
		or not targetHRP:IsA("BasePart") then

		model:Destroy()
		return false, "Target avatar has no HumanoidRootPart."
	end

	-- Position target on real player
	model:PivotTo(realHRP.CFrame)

	--==================================================
	-- BEEHUB-STYLE WELD
	--==================================================

	local weld = Instance.new("WeldConstraint")

	weld.Part0 = targetHRP
	weld.Part1 = realHRP
	weld.Parent = targetHRP

	-- Save overlay
	Overlay.model = model
	Overlay.hrp = targetHRP
	Overlay.weld = weld

	Overlay.lastUserId = userId
	Overlay.lastUsername = result

	-- Build matching Motor6D pairs
	buildMotorPairs(character, model)

	-- Start pose mirroring
	startPoseMirror()

	-- Hide real avatar locally
	hideRealAvatar(character)

	return true, "Avatar changed to " .. tostring(result)
end

