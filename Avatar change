--==================================================
-- RESPAWN
--==================================================

CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(Character)

	-- REMOVE OLD VISUAL
	RemoveAvatar()

	-- NEW REAL CHARACTER
	RealCharacter = Character

	-- ENSURE NEW CHARACTER IS VISIBLE
	task.defer(function()
		if Character and Character.Parent then
			RestoreRealCharacter(Character)
		end
	end)
end)
