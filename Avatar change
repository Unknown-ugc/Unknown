-- LOADING SCREEN FUNCTION (5 SECONDS)
-- ============================================================
local function showLoadingScreen()
    local loadGui = Instance.new("ScreenGui")
    loadGui.Name = "CAT_LOADING"
    loadGui.ResetOnSpawn = false
    loadGui.IgnoreGuiInset = true
    loadGui.DisplayOrder = 999999
    loadGui.Parent = playerGui

    local blackScreen = Instance.new("Frame")
    blackScreen.Size = UDim2.fromScale(1, 1)
    blackScreen.Position = UDim2.fromScale(0, 0)
    blackScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    blackScreen.BackgroundTransparency = 0
    blackScreen.BorderSizePixel = 0
    blackScreen.ZIndex = 1
    blackScreen.Parent = loadGui

    local loadImage = Instance.new("ImageLabel")
    loadImage.Size = UDim2.fromOffset(80, 80)
    loadImage.Position = UDim2.new(0.5, -40, 0.5, -60)
    loadImage.BackgroundTransparency = 1
    loadImage.Image = "https://www.roblox.com/asset-thumbnail/image?assetId=85422381974829&width=420&height=420&format=png"
    loadImage.ZIndex = 2
    loadImage.Parent = blackScreen

    local loadText = Instance.new("TextLabel")
    loadText.Size = UDim2.new(1, 0, 0, 30)
    loadText.Position = UDim2.new(0, 0, 0.5, 30)
    loadText.BackgroundTransparency = 1
    loadText.Text = "Loading..."
    loadText.TextColor3 = Color3.fromRGB(255, 255, 255)
    loadText.Font = Enum.Font.GothamBold
    loadText.TextSize = 18
    loadText.TextXAlignment = Enum.TextXAlignment.Center
    loadText.ZIndex = 2
    loadText.Parent = blackScreen

    local dots = 0
    local dotLoop = task.spawn(function()
        while loadText.Parent do
            dots = (dots + 1) % 4
            loadText.Text = "Loading" .. string.rep(".", dots)
            task.wait(0.5)
        end
    end)

    task.wait(5)

    task.cancel(dotLoop)
    loadGui:Destroy()
end

-- ============================================================
-- TELEPORT WITH COOLDOWN
-- ============================================================
local function startTeleportWithCooldown()
    if isOnCooldown then
        return
    end
    isOnCooldown = true

    showLoadingScreen()

    local cooldown = 10
    statusLabel.Text = "   ⏳ COOLDOWN: " .. cooldown .. "s"
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)

    local cooldownLoop = task.spawn(function()
        for i = cooldown, 1, -1 do
            statusLabel.Text = "   ⏳ COOLDOWN: " .. i .. "s"
            task.wait(1)
        end
    end)

    task.wait(cooldown)

    task.cancel(cooldownLoop)
    isOnCooldown = false
    statusLabel.Text = "   ●  SYSTEM READY"
    statusLabel.TextColor3 = color5
end

-- ============================================================
-- PROXIMITY PROMPT TRIGGER
-- ============================================================
proximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player ~= localPlayer then return end
    if not v2 then return end
    if isOnCooldown then return end

    startTeleportWithCooldown()

    local character = localPlayer.Character
    if not character then return end

    -- Execute teleport route
    for index, value in ipairs(v1) do
        if not v2 then
            statusLabel.Text = "   ○  ROUTE STOPPED"
            statusLabel.TextColor3 = color6
            return
        end
        statusLabel.Text = "   [TP] POINT " .. index .. "/" .. #v1
        statusLabel.TextColor3 = color3
        character:PivotTo(CFrame.new(value))
        if index < #v1 then
            runService.Heartbeat:Wait()
        end
    end

    statusLabel.Text = "   [OK] ROUTE COMPLETE"
    statusLabel.TextColor3 = color5
end)

