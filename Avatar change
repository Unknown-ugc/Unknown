--========================================================
-- DRAGGING
--========================================================

local function makeDraggable(object)

    local dragging = false
    local dragStart
    local startPosition
    local moved = false

    object.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            moved = false

            dragStart = input.Position
            startPosition = object.Position

            input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end

            end)
        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            if math.abs(delta.X) > 4
            or math.abs(delta.Y) > 4 then
                moved = true
            end

            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end

    end)

    return function()
        return moved
    end
end

local MainWasDragged = makeDraggable(Main)
local MiniWasDragged = makeDraggable(Mini)

--========================================================
-- GET CHARACTER
--========================================================

local function getCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

--========================================================
-- STOP MIRROR
--========================================================

local function stopMirror()

    if MirrorConnection then
        MirrorConnection:Disconnect()
        MirrorConnection = nil
    end

    table.clear(MotorPairs)
end

--========================================================
-- RESTORE REAL CHARACTER
--========================================================

local function restoreRealCharacter()

    for object, transparency in pairs(HiddenParts) do

        if object and object.Parent then

            if object:IsA("BasePart") then

                object.LocalTransparencyModifier =
                    transparency

            elseif object:IsA("Decal")
            or object:IsA("Texture") then

                object.Transparency =
                    transparency
            end
        end
    end

    table.clear(HiddenParts)
end

--========================================================
-- HIDE REAL CHARACTER
--========================================================

local function hideRealCharacter(character)

    table.clear(HiddenParts)

    for _, object in ipairs(character:GetDescendants()) do

        if object:IsA("BasePart") then

            HiddenParts[object] =
                object.LocalTransparencyModifier

            object.LocalTransparencyModifier = 1

        elseif object:IsA("Decal")
        or object:IsA("Texture") then

            HiddenParts[object] =
                object.Transparency

            object.Transparency = 1
        end
    end
end

--========================================================
-- PREPARE VISUAL AVATAR
--========================================================

local function prepareVisual(model)

    for _, object in ipairs(model:GetDescendants()) do

        if object:IsA("BasePart") then

            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false
            object.Massless = true

        elseif object:IsA("Script")
        or object:IsA("LocalScript")
        or object:IsA("ModuleScript") then

            object:Destroy()
        end
    end

    local humanoid =
        model:FindFirstChildOfClass("Humanoid")

    if humanoid then

        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        humanoid.Sit = true
    end
end

--========================================================
-- MOTOR KEY
--========================================================

local function getMotorKey(motor)

    local p0 = motor.Part0
        and motor.Part0.Name
        or ""

    local p1 = motor.Part1
        and motor.Part1.Name
        or ""

    return motor.Name .. "|" .. p0 .. "|" .. p1
end

--========================================================
-- BUILD MOTOR PAIRS
--========================================================

local function buildMotorPairs(realCharacter, visualModel)

    table.clear(MotorPairs)

    local realMotors = {}
    local visualMotors = {}

    for _, object in ipairs(realCharacter:GetDescendants()) do

        if object:IsA("Motor6D") then
            realMotors[getMotorKey(object)] = object
        end
    end

    for _, object in ipairs(visualModel:GetDescendants()) do

        if object:IsA("Motor6D") then
            visualMotors[getMotorKey(object)] = object
        end
    end

    for key, realMotor in pairs(realMotors) do

        local visualMotor = visualMotors[key]

        if visualMotor then

            table.insert(MotorPairs, {
                real = realMotor,
                visual = visualMotor
            })
        end
    end
end

--========================================================
-- START POSE MIRROR
--========================================================

local function startMirror(realCharacter, visualModel)

    stopMirror()

    MirrorConnection =
        RunService.RenderStepped:Connect(function()

            if not realCharacter.Parent
            or not visualModel.Parent then

                return
            end

            for _, pair in ipairs(MotorPairs) do

                local realMotor = pair.real
                local visualMotor = pair.visual

                if realMotor.Parent
                and visualMotor.Parent then

                    visualMotor.Transform =
                        realMotor.Transform
                end
            end
        end)
end

--========================================================
-- REMOVE AVATAR
--========================================================

local function removeAvatar()

    Changing = true

    -- Stop animation/pose mirroring
    stopMirror()

    -- Destroy visual model
    if VisualAvatar then

        pcall(function()
            VisualAvatar:Destroy()
        end)

        VisualAvatar = nil
    end

    -- Restore real Roblox avatar
    restoreRealCharacter()

    Changing = false
end

--========================================================
-- CHANGE AVATAR
--========================================================

local function changeAvatar(username)

    if Changing then
        return false, "Please wait..."
    end

    username = tostring(username or "")
    username = username:gsub("^%s+", "")
    username = username:gsub("%s+$", "")

    if username == "" then
        return false, "Enter username."
    end

    Changing = true

    -- Remove previous avatar first
    removeAvatar()

    local realCharacter = getCharacter()

    local realHRP =
        realCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not realHRP then
        Changing = false
        return false, "Character not ready."
    end

    -- Get Roblox UserId
    local idSuccess, userId =
        pcall(function()

            return Players:GetUserIdFromNameAsync(
                username
            )

        end)

    if not idSuccess or not userId then

        Changing = false
        return false, "Username not found."
    end

    -- Create avatar from username's UserId
    local avatarSuccess, model =
        pcall(function()

            return Players:
                CreateHumanoidModelFromUserIdAsync(
                    userId
                )

        end)

    if not avatarSuccess or not model then

        Changing = false
        return false, "Could not load avatar."
    end

    -- Prepare visual avatar
    prepareVisual(model)

    model.Name = "ChrisVisualAvatar"

    -- Put it in CurrentCamera
    local camera = workspace.CurrentCamera

    if not camera then
        model:Destroy()
        Changing = false
        return false, "Camera unavailable."
    end

    model.Parent = camera

    local visualHRP =
        model:FindFirstChild(
            "HumanoidRootPart"
        )

    if not visualHRP then

        model:Destroy()

        Changing = false
        return false, "Avatar has no root part."
    end

    -- Put visual exactly on player
    model:PivotTo(
        realHRP.CFrame
    )

    --====================================================
    -- WELD VISUAL TO REAL PLAYER
    --====================================================

    local weld =
        Instance.new("WeldConstraint")

    weld.Name = "AvatarVisualWeld"
    weld.Part0 = visualHRP
    weld.Part1 = realHRP
    weld.Parent = visualHRP

    -- Save model
    VisualAvatar = model

    -- Match real player's joints
    buildMotorPairs(
        realCharacter,
        model
    )

    -- Start matching animation pose
    startMirror(
        realCharacter,
        model
    )

    -- Hide real character locally
    hideRealCharacter(
        realCharacter
    )

    Changing = false

    return true,
        "Changed to @" .. username
end

