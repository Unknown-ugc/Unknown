--==================================================
-- CHRIS AVATAR OVERLAY
-- BeeHub-style avatar overlay method
-- Real character = movement + animation source
-- Visual character = welded overlay
--==================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Overlay = {
    model = nil,
    hrp = nil,
    weld = nil,
    renderConn = nil,
    motorPairs = {},
    hiddenParts = {},
    lastUserId = nil,
    lastUsername = nil
}

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP(character)
    return character
        and character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- OVERLAY FOLDER
--==================================================

local function getOverlayFolder()
    local camera = workspace.CurrentCamera

    if not camera then
        return nil
    end

    local folder = camera:FindFirstChild("_ChrisAvatarOverlay")

    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "_ChrisAvatarOverlay"
        folder.Parent = camera
    end

    return folder
end

--==================================================
-- STOP MIRROR
--==================================================

local function stopMirror()
    if Overlay.renderConn then
        Overlay.renderConn:Disconnect()
        Overlay.renderConn = nil
    end
end

--==================================================
-- CLEAR MOTOR PAIRS
--==================================================

local function clearMotorPairs()
    table.clear(Overlay.motorPairs)
end

--==================================================
-- RESTORE REAL AVATAR
--==================================================

local function restoreRealAvatar()

    for instance, previousTransparency in pairs(
        Overlay.hiddenParts
    ) do

        if instance and instance.Parent then

            if instance:IsA("BasePart") then
                instance.LocalTransparencyModifier =
                    previousTransparency

            elseif instance:IsA("Decal")
                or instance:IsA("Texture") then

                instance.Transparency =
                    previousTransparency
            end
        end
    end

    table.clear(Overlay.hiddenParts)
end

--==================================================
-- HIDE REAL AVATAR
--==================================================

local function hideRealAvatar(character)

    if not character then
        return
    end

    table.clear(Overlay.hiddenParts)

    for _, instance in ipairs(
        character:GetDescendants()
    ) do

        if instance:IsA("BasePart") then

            Overlay.hiddenParts[instance] =
                instance.LocalTransparencyModifier

            instance.LocalTransparencyModifier = 1

        elseif instance:IsA("Decal")
            or instance:IsA("Texture") then

            Overlay.hiddenParts[instance] =
                instance.Transparency

            instance.Transparency = 1
        end
    end
end

--==================================================
-- PREPARE VISUAL AVATAR
--==================================================

local function prepareModel(model)

    for _, instance in ipairs(
        model:GetDescendants()
    ) do

        if instance:IsA("Script")
            or instance:IsA("LocalScript") then

            instance.Disabled = true

        elseif instance:IsA("BasePart") then

            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.Massless = true
        end
    end

    local humanoid =
        model:FindFirstChildOfClass("Humanoid")

    if humanoid then

        -- The visual avatar must NOT control movement.
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
        humanoid.Sit = true

        humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Physics,
            false
        )
    end

    return model
end

--==================================================
-- MOTOR KEY
--==================================================

local function motorKey(motor)

    local part0 =
        motor.Part0
        and motor.Part0.Name
        or "nil"

    local part1 =
        motor.Part1
        and motor.Part1.Name
        or "nil"

    return motor.Name
        .. "|"
        .. part0
        .. ">"
        .. part1
end

--==================================================
-- BUILD MOTOR PAIRS
--==================================================

local function buildMotorPairs(
    sourceCharacter,
    targetModel
)

    clearMotorPairs()

    local sourceMotors = {}
    local targetMotors = {}

    for _, instance in ipairs(
        sourceCharacter:GetDescendants()
    ) do

        if instance:IsA("Motor6D") then
            sourceMotors[motorKey(instance)] =
                instance
        end
    end

    for _, instance in ipairs(
        targetModel:GetDescendants()
    ) do

        if instance:IsA("Motor6D") then
            targetMotors[motorKey(instance)] =
                instance
        end
    end

    for key, sourceMotor in pairs(sourceMotors) do

        local targetMotor =
            targetMotors[key]

        if targetMotor then

            table.insert(
                Overlay.motorPairs,
                {
                    src = sourceMotor,
                    tgt = targetMotor
                }
            )
        end
    end
end

--==================================================
-- MIRROR REAL PLAYER POSE
--==================================================

local function startMirror()

    stopMirror()

    Overlay.renderConn =
        RunService.RenderStepped:Connect(
        function()

            if not Overlay.model
                or not Overlay.hrp then
                return
            end

            for _, pair in ipairs(
                Overlay.motorPairs
            ) do

                local source = pair.src
                local target = pair.tgt

                if source
                    and target
                    and source.Parent
                    and target.Parent then

                    target.Transform =
                        source.Transform
                end
            end
        end
    )
end

--==================================================
-- REMOVE AVATAR
--==================================================

local function removeAvatar()

    -- STOP MOVEMENT MIRROR FIRST
    stopMirror()

    -- CLEAR JOINT REFERENCES
    clearMotorPairs()

    -- REMOVE VISUAL AVATAR
    if Overlay.model then

        pcall(function()
            Overlay.model:Destroy()
        end)
    end

    Overlay.model = nil
    Overlay.hrp = nil
    Overlay.weld = nil

    -- RESTORE REAL ROBLOX AVATAR
    restoreRealAvatar()

    Overlay.lastUserId = nil
    Overlay.lastUsername = nil
end

--==================================================
-- CHANGE AVATAR
--==================================================

local function changeAvatar(username)

    username = tostring(username or "")
    username = username:gsub("^%s+", "")
    username = username:gsub("%s+$", "")

    if username == "" then
        return false, "Enter username."
    end

    local success, userId =
        pcall(function()
            return Players:GetUserIdFromNameAsync(
                username
            )
        end)

    if not success or not userId then
        return false, "Username not found."
    end

    local realCharacter = getCharacter()
    local realHRP = getHRP(realCharacter)

    if not realHRP then
        return false, "Character not ready."
    end

    -- REMOVE OLD AVATAR FIRST
    removeAvatar()

    -- CREATE TARGET AVATAR
    local modelSuccess, targetModel =
        pcall(function()

            return Players:
                CreateHumanoidModelFromUserIdAsync(
                    userId
                )
        end)

    if not modelSuccess
        or not targetModel then

        return false, "Failed to create avatar."
    end

    -- PREPARE VISUAL MODEL
    prepareModel(targetModel)

    targetModel.Name =
        "ChrisAvatarOverlay"

    -- CAMERA FOLDER
    local folder =
        getOverlayFolder()

    if not folder then
        targetModel:Destroy()
        return false, "Camera not ready."
    end

    targetModel.Parent = folder

    -- TARGET ROOT
    local targetHRP =
        targetModel:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then

        targetModel:Destroy()

        return false,
            "Target avatar has no HumanoidRootPart."
    end

    --==================================================
    -- IMPORTANT:
    -- PUT TARGET EXACTLY ON REAL CHARACTER
    --==================================================

    targetModel:PivotTo(
        realHRP.CFrame
    )

    --==================================================
    -- WELD TARGET TO REAL CHARACTER
    --==================================================

    local weld =
        Instance.new("WeldConstraint")

    weld.Name = "ChrisAvatarWeld"
    weld.Part0 = targetHRP
    weld.Part1 = realHRP
    weld.Parent = targetHRP

    Overlay.model = targetModel
    Overlay.hrp = targetHRP
    Overlay.weld = weld

    Overlay.lastUserId = userId
    Overlay.lastUsername = username

    --==================================================
    -- COPY MOTOR6D POSES
    --==================================================

    buildMotorPairs(
        realCharacter,
        targetModel
    )

    startMirror()

    --==================================================
    -- HIDE REAL AVATAR LOCALLY
    --==================================================

    hideRealAvatar(
        realCharacter
    )

    return true,
        "Avatar changed: " .. username
end

--==================================================
-- BUTTON CONNECTIONS
--==================================================

-- CHANGE BUTTON
ChangeButton.MouseButton1Click:Connect(
    function()

        local success, message =
            changeAvatar(
                UsernameBox.Text
            )

        if success then
            UsernameBox.PlaceholderText =
                "Avatar active"
        else
            UsernameBox.PlaceholderText =
                message
        end
    end
)

-- REMOVE BUTTON
RemoveButton.MouseButton1Click:Connect(
    function()

        removeAvatar()

        -- EXTRA SAFETY:
        -- make sure the current real avatar
        -- is visible again.
        local character =
            LocalPlayer.Character

        if character then

            for _, instance in ipairs(
                character:GetDescendants()
            ) do

                if instance:IsA("BasePart") then
                    instance.LocalTransparencyModifier = 0

                elseif instance:IsA("Decal")
                    or instance:IsA("Texture") then

                    instance.Transparency = 0
                end
            end
        end

        UsernameBox.Text = ""
        UsernameBox.PlaceholderText =
            "Enter username..."
    end
)

--==================================================
-- RESPAWN SAFETY
--==================================================

LocalPlayer.CharacterAdded:Connect(
    function(newCharacter)

        -- Completely remove old overlay
        removeAvatar()

        -- Make new Roblox avatar visible
        task.wait(0.15)

        for _, instance in ipairs(
            newCharacter:GetDescendants()
        ) do

            if instance:IsA("BasePart") then
                instance.LocalTransparencyModifier = 0

            elseif instance:IsA("Decal")
                or instance:IsA("Texture") then

                instance.Transparency = 0
            end
        end
    end
)
