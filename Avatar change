local OverlayModel = nil
local AnimationConnection = nil
local CharacterConnection = nil

local OriginalTransparency = {}
local MotorPairs = {}

--==================================================
-- ORIGINAL CHARACTER TRANSPARENCY
--==================================================

local function saveTransparency()
	OriginalTransparency = {}

	local Character = LocalPlayer.Character
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			OriginalTransparency[Object] =
				Object.LocalTransparencyModifier
		end
	end
end

local function hideOriginal()
	local Character = LocalPlayer.Character
	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			Object.LocalTransparencyModifier = 1
		end
	end
end

local function restoreOriginal()
	local Character = LocalPlayer.Character

	if Character then
		for _, Object in ipairs(Character:GetDescendants()) do
			if Object:IsA("BasePart") then
				Object.LocalTransparencyModifier =
					OriginalTransparency[Object] or 0
			end
		end
	end

	OriginalTransparency = {}
end

--==================================================
-- MOTOR MATCHING
--==================================================

local function BuildMotorPairs(Character, Overlay)
	MotorPairs = {}

	for _, OriginalMotor in ipairs(Character:GetDescendants()) do
		if OriginalMotor:IsA("Motor6D") then

			local OriginalPart0 = OriginalMotor.Part0
			local OriginalPart1 = OriginalMotor.Part1

			if OriginalPart0 and OriginalPart1 then

				local OverlayPart0 =
					Overlay:FindFirstChild(OriginalPart0.Name, true)

				local OverlayPart1 =
					Overlay:FindFirstChild(OriginalPart1.Name, true)

				if OverlayPart0 and OverlayPart1 then

					local OverlayMotor =
						Overlay:FindFirstChild(OriginalMotor.Name, true)

					if OverlayMotor and OverlayMotor:IsA("Motor6D") then
						table.insert(MotorPairs, {
							Original = OriginalMotor,
							Overlay = OverlayMotor
						})
					end
				end
			end
		end
	end
end

--==================================================
-- REMOVE AVATAR
--==================================================

local function RemoveAvatar()
	if AnimationConnection then
		AnimationConnection:Disconnect()
		AnimationConnection = nil
	end

	if CharacterConnection then
		CharacterConnection:Disconnect()
		CharacterConnection = nil
	end

	MotorPairs = {}

	if OverlayModel then
		OverlayModel:Destroy()
		OverlayModel = nil
	end

	restoreOriginal()

	Status.Text = "Original avatar restored"
end

--==================================================
-- GET USER ID FROM USERNAME
--==================================================

local function GetUserId(Username)
	Username = Username:gsub("^%s+", "")
	Username = Username:gsub("%s+$", "")

	if Username == "" then
		return nil
	end

	local Success, UserId = pcall(function()
		return Players:GetUserIdFromNameAsync(Username)
	end)

	if Success then
		return UserId
	end

	return nil
end

--==================================================
-- CHANGE AVATAR
--==================================================

local function ChangeAvatar()

	local Username = UsernameBox.Text

	if Username == "" then
		Status.Text = "Enter a Roblox username"
		return
	end

	Status.Text = "Loading avatar..."

	local UserId = GetUserId(Username)

	if not UserId then
		Status.Text = "Username not found"
		return
	end

	RemoveAvatar()

	local Success, Model = pcall(function()
		return Players:CreateHumanoidModelFromUserIdAsync(UserId)
	end)

	if not Success or not Model then
		Status.Text = "Could not load avatar"
		return
	end

	local Character = LocalPlayer.Character

	if not Character then
		Model:Destroy()
		Status.Text = "Character not found"
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	local OverlayRoot = Model:FindFirstChild("HumanoidRootPart")

	if not Root or not OverlayRoot then
		Model:Destroy()
		Status.Text = "Avatar rig error"
		return
	end

	OverlayModel = Model
	OverlayModel.Name = "_ChrisAvatarOverlay"
	OverlayModel.Parent = workspace.CurrentCamera

	saveTransparency()

	-- Match starting position
	OverlayModel:PivotTo(Character:GetPivot())

	-- Make overlay non-collidable
	for _, Object in ipairs(OverlayModel:GetDescendants()) do
		if Object:IsA("BasePart") then
			Object.CanCollide = false
			Object.CanTouch = false
			Object.CanQuery = false
			Object.Massless = true
		end
	end

	-- Match Motor6Ds
	BuildMotorPairs(Character, OverlayModel)

	-- Hide original
	hideOriginal()

	-- Follow movement + animations
	AnimationConnection = RunService.RenderStepped:Connect(function()

		if not OverlayModel or not OverlayModel.Parent then
			return
		end

		local CurrentCharacter = LocalPlayer.Character

		if not CurrentCharacter then
			return
		end

		-- Follow whole character position
		OverlayModel:PivotTo(CurrentCharacter:GetPivot())

		-- Copy animation/joint transforms
		for _, Pair in ipairs(MotorPairs) do

			local Original = Pair.Original
			local Overlay = Pair.Overlay

			if Original.Parent and Overlay.Parent then
				Overlay.Transform = Original.Transform
			end
		end
	end)

	Status.Text = "Avatar changed"
end

