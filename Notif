local function send(creature)

	local name = creature[1]
	local rarity = creature[2]
	local color = creature[3]
	local biome = creature[4]
	local speed = creature[5]

	local role = ROLES[rarity]
	local webhook = WEBHOOKS[rarity]
	local image = PET_IMAGES[name]
	local money = MONEY[name] or "Unknown"

	if not webhook or webhook == "" or webhook:find("YOUR_") then
		warn("Webhook not configured for:", rarity)
		return
	end

	local timestamp = os.time()

	local description =
		"ðŸ¥š **Egg Spawn Detected!**\n\n" ..
