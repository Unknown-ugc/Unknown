	CFrame.new(
		550.9732055664062,
		70.57628631591797,
		-377.2372741699219
	)
	* CFrame.Angles(
		1.0725773567921149e-11,
		1.4790611267089844,
		1.657335713812218e-09
	)

local enabled = false
local running = false

