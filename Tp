--==================================================
-- LOADING SCREEN
--==================================================

local loadingGui
local loadingText

local function showLoading()
	if loadingGui then
		return
	end

	loadingGui = Instance.new("ScreenGui")
	loadingGui.Name = "TeleportLoading"
	loadingGui.ResetOnSpawn = false
	loadingGui.DisplayOrder = 999999
	loadingGui.IgnoreGuiInset = true
	loadingGui.Parent = player:WaitForChild("PlayerGui")

	local background = Instance.new("Frame")
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	background.BackgroundTransparency = 0.25
	background.BorderSizePixel = 0
	background.Parent = loadingGui

	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(250, 100)
	box.Position = UDim2.new(0.5, -125, 0.5, -50)
	box.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	box.BorderSizePixel = 0
	box.Parent = background

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 12)
	boxCorner.Parent = box

	loadingText = Instance.new("TextLabel")
	loadingText.Size = UDim2.fromScale(1, 1)
	loadingText.BackgroundTransparency = 1
	loadingText.Text = "Teleporting... 0/4"
	loadingText.TextColor3 = Color3.new(1, 1, 1)
	loadingText.TextSize = 19
	loadingText.Font = Enum.Font.GothamBold
	loadingText.Parent = box
end

local function updateLoading(count)
	if loadingText then
		loadingText.Text = "Teleporting... " .. count .. "/4"
	end
end

local function hideLoading()
	if loadingGui then
		loadingGui:Destroy()
		loadingGui = nil
		loadingText = nil
	end
end

--==================================================
-- TOGGLE
--==================================================

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(50, 170, 90)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(170, 55, 55)

		running = false
		hideLoading()
	end
end)

--==================================================
-- TELEPORT ×4
--==================================================

local function teleportFourTimes()
	if not enabled or running then
		return
	end

	running = true

	-- Loading appears BEFORE teleport #1
	showLoading()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		for i = 1, 4 do
			-- Update the visible counter
			updateLoading(i)

			-- Instant teleport
			root.CFrame = TP_CFRAME
		end
	end

	-- Loading disappears ONLY after all 4 are complete
	hideLoading()

	running = false
end

--==================================================
-- PROXIMITY PROMPTS
--==================================================

local function setupPrompt(object)
	if not object:IsA("ProximityPrompt") then
		return
	end

	object.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			teleportFourTimes()
		end
	end)
end

for _, object in ipairs(workspace:GetDescendants()) do
	setupPrompt(object)
end

workspace.DescendantAdded:Connect(setupPrompt)
