local Players = game:GetService("Players")

local player = Players.LocalPlayer

local TP_CFRAME =
	CFrame.new(
		550.9732055664062,
		70.57628631591797,
		-377.2372741699219
	) *
	CFrame.Angles(
		1.0725773567921149e-11,
		1.4790611267089844,
		1.657335713812218e-09
	)

local enabled = false
local running = false

--========================
-- MAIN GUI
--========================

local gui = Instance.new("ScreenGui")
gui.Name = "FastTP4"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(170, 48)
button.Position = UDim2.new(0.5, -85, 0.5, -24)
button.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
button.Text = "TP ×4 : OFF"
button.TextColor3 = Color3.new(1, 1, 1)
button.TextSize = 16
button.Font = Enum.Font.GothamBold
button.Active = true
button.Draggable = true
button.Parent = gui

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 9)

--========================
-- LOADING SCREEN
--========================

local loadingGui
local loadingText

local function showLoading()
	if loadingGui then
		return
	end

	loadingGui = Instance.new("ScreenGui")
	loadingGui.Name = "TPLoading"
	loadingGui.ResetOnSpawn = false
	loadingGui.DisplayOrder = 999999
	loadingGui.Parent = player.PlayerGui

	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(250, 90)
	box.Position = UDim2.new(0.5, -125, 0.5, -45)
	box.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	box.BorderSizePixel = 0
	box.Parent = loadingGui

	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

	loadingText = Instance.new("TextLabel")
	loadingText.Size = UDim2.fromScale(1, 1)
	loadingText.BackgroundTransparency = 1
	loadingText.Text = "Teleporting 0/4"
	loadingText.TextColor3 = Color3.new(1, 1, 1)
	loadingText.TextSize = 19
	loadingText.Font = Enum.Font.GothamBold
	loadingText.Parent = box
end

local function hideLoading()
	if loadingGui then
		loadingGui:Destroy()
		loadingGui = nil
		loadingText = nil
	end
end

local function updateLoading(number)
	if loadingText then
		loadingText.Text = "Teleporting " .. number .. "/4"
	end
end

--========================
-- ON / OFF
--========================

button.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		button.Text = "TP ×4 : ON"
		button.BackgroundColor3 = Color3.fromRGB(50, 170, 90)
	else
		button.Text = "TP ×4 : OFF"
		button.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
	end
end)

--========================
-- FAST 4× TELEPORT
--========================

local function teleportFourTimes()
	if not enabled or running then
		return
	end

	running = true

	-- Show loading BEFORE first teleport
	showLoading()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		for i = 1, 4 do
			updateLoading(i)

			-- Separate teleport event
			root.CFrame = TP_CFRAME

			-- Very small yield so Roblox registers it separately
			if i < 4 then
				task.wait(0.03)
			end
		end
	end

	-- Only remove after all 4
	hideLoading()

	running = false
end

--========================
-- PROXIMITY PROMPT
--========================

local function connectPrompt(object)
	if not object:IsA("ProximityPrompt") then
		return
	end

	object.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			teleportFourTimes()
		end
	end)
end

for _, object in ipairs(workspace:GetDescendants()) do
	connectPrompt(object)
end

workspace.DescendantAdded:Connect(connectPrompt)
