--==================================================
-- 4× TELEPORT
--==================================================

local function teleportFourTimes()
	if not enabled or running then
		return
	end

	running = true

	-- Loading starts immediately
	createLoading()
	updateLoading(0)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		for i = 1, TELEPORT_COUNT do

			-- Progress:
			-- 1 = 25%
			-- 2 = 50%
			-- 3 = 75%
			-- 4 = 100%
			updateLoading((i / TELEPORT_COUNT) * 100)

			-- Separate teleport
			root.CFrame = TP_CFRAME

			-- 0.1 second between teleports
			if i < TELEPORT_COUNT then
				task.wait(TELEPORT_DELAY)
			end
		end
	end

	-- Make sure it displays 100%
	updateLoading(100)

	-- Keep loading screen for 4 seconds AFTER TP #4
	task.wait(FINISH_LOADING_TIME)

	-- Now remove it
	removeLoading()

	running = false
end

--==================================================
-- PROXIMITY PROMPT
--==================================================

local function connectPrompt(object)
	if not object:IsA("ProximityPrompt") then
		return
	end

	object.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			teleportFourTimes()
		end
	end)
end

-- Existing prompts
for _, object in ipairs(workspace:GetDescendants()) do
	connectPrompt(object)
end

-- New prompts
workspace.DescendantAdded:Connect(connectPrompt)
