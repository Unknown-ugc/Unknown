local Players = game:GetService("Players")

local player = Players.LocalPlayer

local TP_CFRAME =
	CFrame.new(
		550.9732055664062,
		70.57628631591797,
		-377.2372741699219
	) *
	CFrame.Angles(
		1.0725773567921149e-11,
		1.4790611267089844,
		1.657335713812218e-09
	)

local enabled = false
local running = false

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "TP4GUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(160, 50)
button.Position = UDim2.new(0.5, -80, 0.5, -25)
button.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
button.Text = "TP ×4 : OFF"
button.TextColor3 = Color3.new(1,1,1)
button.TextSize = 16
button.Font = Enum.Font.GothamBold
button.Active = true
button.Draggable = true
button.Parent = gui

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

-- Loading screen
local loadingGui

local function showLoading()
	if loadingGui then return end

	loadingGui = Instance.new("ScreenGui")
	loadingGui.Name = "TPLoading"
	loadingGui.ResetOnSpawn = false
	loadingGui.DisplayOrder = 999999
	loadingGui.Parent = player.PlayerGui

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromOffset(240, 70)
	text.Position = UDim2.new(0.5, -120, 0.5, -35)
	text.BackgroundColor3 = Color3.fromRGB(20,20,25)
	text.Text = "Teleporting 0/4"
	text.TextColor3 = Color3.new(1,1,1)
	text.TextSize = 20
	text.Font = Enum.Font.GothamBold
	text.Parent = loadingGui

	Instance.new("UICorner", text).CornerRadius = UDim.new(0, 10)
end

local function updateLoading(number)
	if loadingGui then
		local text = loadingGui:FindFirstChildWhichIsA("TextLabel", true)

		if text then
			text.Text = "Teleporting " .. number .. "/4"
		end
	end
end

local function hideLoading()
	if loadingGui then
		loadingGui:Destroy()
		loadingGui = nil
	end
end

-- ON / OFF
button.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		button.Text = "TP ×4 : ON"
		button.BackgroundColor3 = Color3.fromRGB(50,170,90)
	else
		button.Text = "TP ×4 : OFF"
		button.BackgroundColor3 = Color3.fromRGB(170,55,55)
	end
end)

-- 4 TELEPORT TRIGGERS
local function triggerFourTimes()
	if not enabled or running then
		return
	end

	running = true
	showLoading()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		for i = 1, 4 do
			updateLoading(i)

			-- Trigger teleport
			root.CFrame = TP_CFRAME
		end
	end

	-- Remove loading AFTER all 4
	hideLoading()

	running = false
end

-- Detect ProximityPrompt
local function connectPrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end

	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			triggerFourTimes()
		end
	end)
end

for _, object in ipairs(workspace:GetDescendants()) do
	connectPrompt(object)
end

workspace.DescendantAdded:Connect(connectPrompt)
