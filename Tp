--==================================================
-- LOADING
--==================================================

local function updateLoading(percent)
	if not loadingGui then
		return
	end

	percent = math.clamp(percent, 0, 100)

	if progressText then
		progressText.Text = math.floor(percent) .. "%"
	end

	if progressBar then
		progressBar.Size = UDim2.new(percent / 100, 0, 1, 0)
	end
end

local function removeLoading()
	if loadingGui then
		loadingGui:Destroy()
		loadingGui = nil
		progressText = nil
		progressBar = nil
	end
end

