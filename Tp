-- Copy TP GUI
-- Saves your current position and teleports you back to it

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local savedCFrame = nil

local gui = Instance.new("ScreenGui")
gui.Name = "CopyTPGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(180, 125)
frame.Position = UDim2.new(0.5, -90, 0.5, -62)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -35, 0, 30)
title.BackgroundTransparency = 1
title.Text = "Copy TP"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(30, 30)
close.Position = UDim2.new(1, -30, 0, 0)
close.BackgroundTransparency = 1
close.Text = "×"
close.TextColor3 = Color3.fromRGB(255, 80, 80)
close.TextSize = 22
close.Font = Enum.Font.GothamBold
close.Parent = frame

close.MouseButton1Click:Connect(function()
	gui:Destroy()
end)

local copyButton = Instance.new("TextButton")
copyButton.Size = UDim2.new(1, -20, 0, 35)
copyButton.Position = UDim2.fromOffset(10, 35)
copyButton.BackgroundColor3 = Color3.fromRGB(45, 100, 200)
copyButton.Text = "Copy TP"
copyButton.TextColor3 = Color3.new(1, 1, 1)
copyButton.TextSize = 15
copyButton.Font = Enum.Font.GothamBold
copyButton.Parent = frame

local copyCorner = Instance.new("UICorner")
copyCorner.CornerRadius = UDim.new(0, 7)
copyCorner.Parent = copyButton

local tpButton = Instance.new("TextButton")
tpButton.Size = UDim2.new(1, -20, 0, 35)
tpButton.Position = UDim2.fromOffset(10, 78)
tpButton.BackgroundColor3 = Color3.fromRGB(50, 160, 90)
tpButton.Text = "Teleport"
tpButton.TextColor3 = Color3.new(1, 1, 1)
tpButton.TextSize = 15
tpButton.Font = Enum.Font.GothamBold
tpButton.Parent = frame

local tpCorner = Instance.new("UICorner")
tpCorner.CornerRadius = UDim.new(0, 7)
tpCorner.Parent = tpButton

copyButton.MouseButton1Click:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		savedCFrame = root.CFrame
		copyButton.Text = "Position Saved!"
		task.wait(1)
		copyButton.Text = "Copy TP"
	end
end)

tpButton.MouseButton1Click:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root and savedCFrame then
		root.CFrame = savedCFrame + Vector3.new(0, 3, 0)
	end
end)
