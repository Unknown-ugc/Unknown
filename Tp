	-- 0 → 100 in 2 seconds
	local startTime = os.clock()

	while os.clock() - startTime < LOADING_TIME do
		if not loadingGui then
			return false
		end

		local elapsed = os.clock() - startTime

		local percent = math.clamp(
			(elapsed / LOADING_TIME) * 100,
			0,
			100
		)

		-- 10% steps
		percent = math.floor(percent / 10) * 10

		updateLoading(percent)

		task.wait(0.02)
	end

	updateLoading(100)

	removeLoading()

	return true
end

--==================================================
-- TELEPORT
--==================================================

local function doTeleportSequence()
	if busy or not enabled then
		return
	end

	local character = player.Character

	if not character or not character.Parent then
		return
	end

	busy = true

	-- Show loading first
	local finishedLoading = showLoading()

	if not finishedLoading then
		busy = false
		return
	end

	character = player.Character

	if not character or not character.Parent then
		busy = false
		return
	end

	-- 6 instant TP calls
	for i = 1, TELEPORT_COUNT do
		if not enabled then
			break
		end

		character:PivotTo(TARGET_CFRAME)

		if TP_DELAY > 0 then
			task.wait(TP_DELAY)
		end
	end

	busy = false
end

