--==================================================
-- 6× TELEPORT
--==================================================

local function teleportSixTimes()
	if not enabled or running then
		return
	end

	running = true

	-- Show loading
	createLoading()
	updateLoading(0)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		for i = 1, TELEPORT_COUNT do

			-- 16.67% per teleport
			updateLoading((i / TELEPORT_COUNT) * 100)

			-- Teleport
			root.CFrame = TP_CFRAME

			-- Wait between teleports
			if i < TELEPORT_COUNT then
				task.wait(TELEPORT_DELAY)
			end
		end
	end

	-- Finished all 6
	updateLoading(100)

	-- Keep loading screen for 4 seconds
	task.wait(FINISH_LOADING_TIME)

	-- Remove loading
	removeLoading()

	running = false
end

--==================================================
-- PROXIMITY PROMPT
--==================================================

local function connectPrompt(object)
	if not object:IsA("ProximityPrompt") then
		return
	end

	object.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			teleportSixTimes()
		end
	end)
end

-- Existing prompts
for _, object in ipairs(workspace:GetDescendants()) do
	connectPrompt(object)
end

-- New prompts
workspace.DescendantAdded:Connect(connectPrompt)
