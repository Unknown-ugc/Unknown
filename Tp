--==================================================
-- 6× TELEPORT + EXACT 3 SECOND LOADING
--==================================================

local function teleportSixTimes()
	if not enabled or running then
		return
	end

	running = true

	createLoading()
	updateLoading(0)

	local startTime = os.clock()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	-- Six separate teleports
	if root then
		for i = 1, TELEPORT_COUNT do

			root.CFrame = TP_CFRAME

			if i < TELEPORT_COUNT then
				task.wait(TELEPORT_DELAY)
			end
		end
	end

	-- Keep loading screen for exactly 3 seconds total
	while os.clock() - startTime < LOADING_TIME do
		local elapsed = os.clock() - startTime
		local percent = math.clamp((elapsed / LOADING_TIME) * 100, 0, 100)

		updateLoading(percent)

		RunService.RenderStepped:Wait()
	end

	-- Exact 100%
	updateLoading(100)

	-- Remove after reaching 100%
	task.wait()

	removeLoading()

	running = false
end

--==================================================
-- PROXIMITY PROMPTS
--==================================================

local function connectPrompt(object)
	if not object:IsA("ProximityPrompt") then
		return
	end

	object.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player then
			teleportSixTimes()
		end
	end)
end

for _, object in ipairs(workspace:GetDescendants()) do
	connectPrompt(object)
end

workspace.DescendantAdded:Connect(connectPrompt)
