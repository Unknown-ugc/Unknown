            local raw = httpGet(apiUrl)
            if raw then
                local data = HttpService:JSONDecode(raw)
                if data and data.data and data.data[1] and data.data[1].imageUrl then
                    avatarUrl = data.data[1].imageUrl
                end
            end
        end)

        local profileUrl = "https://www.roblox.com/users/"..player.UserId.."/profile"
        local placeName = "Unknown Game"
        pcall(function()
            placeName = MarketplaceService:GetProductInfo(game.PlaceId).Name
        end)

        local jobId = game.JobId
        if jobId == "" then jobId = "STUDIO" end
        local joinUrl = "https://www.roblox.com/games/start?placeId="..game.PlaceId.."&gameInstanceId="..jobId

        local body = HttpService:JSONEncode({
            username = "🐱 CAT HUB Tracker",
            embeds = {{
                title = "🎮 Script Used — "..player.Name,
                color = 3447003,
                author = {
                    name = player.Name,
                    icon_url = avatarUrl,
                    url = profileUrl
                },
                thumbnail = { url = avatarUrl },
                image = { url = avatarUrl },
                description = "**[👤 Click to view Profile]("..profileUrl..")**\n"..
                    "**[🚪 Click to Join Server]("..joinUrl..")**",
                fields = {
                    { name = "👤 Player", value = player.Name, inline = true },
                    { name = "🆔 UserId", value = "`"..tostring(player.UserId).."`", inline = true },
                    { name = "🌍 Game", value = placeName, inline = false },
                    { name = "📋 JobId", value = "```"..jobId.."```", inline = false }
                },
                footer = {
                    text = "CAT HUB V1.5.1 • "..os.date("!%Y-%m-%d %H:%M:%S").." UTC",
                    icon_url = avatarUrl
                }
            }}
        })

        if request then
            pcall(function()
                request({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = body
                })
            end)
            warn("[CAT HUB] ✅ Webhook sent")
        elseif syn and syn.request then
            pcall(function()
                syn.request({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = body
                })
            end)
            warn("[CAT HUB] ✅ Webhook sent via syn")
        else
            warn("[CAT HUB] ❌ No HTTP function")
        end
    end)
end

