	-- LootLabs Button Logic
	lootLabsBtn.MouseButton1Click:Connect(function()
		lootLabsBtn.Text = "Generating link..."
		lootLabsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		resultBox.Text = ""

		local baseUrl = "https://creators.lootlabs.gg/api/public/content_locker"
		local params = {
			api_token = API_TOKEN,
			title = "Admin Panel Key",
			url = DESTINATION_URL,
			tier_id = "3",
			number_of_tasks = "3",
			theme = "1",
			thumbnail = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
		}
		
		local queryParts = {}
		for key, value in pairs(params) do
			table.insert(queryParts, key .. "=" .. HttpService:UrlEncode(value))
		end
		local fullUrl = baseUrl .. "?" .. table.concat(queryParts, "&")

		local success, response = pcall(function()
			return HttpService:GetAsync(fullUrl)
		end)

		if success then
			local decodeSuccess, decoded = pcall(function()
				return HttpService:JSONDecode(response)
			end)
			if decodeSuccess and decoded and decoded.message then
				resultBox.Text = decoded.message
				lootLabsBtn.Text = "Link ready! Copy from box above."
				lootLabsBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
			else
				resultBox.Text = "Error: Could not parse response."
				lootLabsBtn.Text = "API Error"
				lootLabsBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
			end
		else
			resultBox.Text = "Error: " .. tostring(response)
			lootLabsBtn.Text = "API Error"
			lootLabsBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		end
		
		task.wait(3)
		lootLabsBtn.Text = "Get Key via LootLabs"
