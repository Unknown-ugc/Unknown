local transparencyDragging = false
transparencyDot.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        transparencyDragging = true
    end
end)
UIS.InputChanged:Connect(function(input)
    if transparencyDragging and
        (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local percent = math.clamp(
            (input.Position.X - transparencyBar.AbsolutePosition.X) /
            transparencyBar.AbsoluteSize.X, 0, 1)
        transparencyDot.Position = UDim2.new(percent,-7,.5,-7)
