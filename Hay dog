local function makeNav(name,y)
    local b = Instance.new("TextButton")
    b.Position = UDim2.fromOffset(4,y)
    b.Size = UDim2.fromOffset(42,38)
    b.BackgroundTransparency = 1
    b.BorderSizePixel = 0
