local function lbl(parent,text,pos,size,font,tsize,color,yAlign)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position = pos; l.Size = size; l.Text = text
    l.Font = font or Enum.Font.Gotham
    l.TextSize = tsize or 8
    l.TextColor3 = color or Theme.Text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = yAlign or Enum.TextYAlignment.Top
    l.TextWrapped = true
    l.Parent = parent
    return l
end

local function btn(parent,text,pos,size,bg,tc,tsize)
    local b = Instance.new("TextButton")
    b.Position = pos; b.Size = size
    b.BackgroundColor3 = bg or Theme.Card
    b.BorderSizePixel = 0; b.Text = text
    b.TextSize = tsize or 8
    b.Font = Enum.Font.GothamBold
    b.TextColor3 = tc or Color3.new(1,1,1)
    b.Parent = parent
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,8)
    return b
end

