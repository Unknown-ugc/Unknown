local function selectNav(sel)
    for _,b in ipairs(navBtns) do b.BackgroundTransparency = 1 end
    sel.BackgroundTransparency = 0
    sel.BackgroundColor3 = Color3.fromRGB(25,40,65)
end

local function showPage(p)
    for _,x in ipairs({home,scriptsPage,serverPage,settingsPage,creditsPage,aboutPage}) do
        x.Visible = false
    end
    p.Visible = true
end

local function bindNav(b,page)
    b.Activated:Connect(function()
        selectNav(b); showPage(page)
    end)
end

