    for _,v in ipairs(serverList:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    serverList.Size = UDim2.new(1,0,0,0)
end

local function addServerCard(s)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1,-6,0,38)
    card.BackgroundColor3 = Theme.Card
    card.BorderSizePixel = 0
    card.Parent = serverList
    Instance.new("UICorner",card).CornerRadius = UDim.new(0,8)

    local playersText = Instance.new("TextLabel")
    playersText.Position = UDim2.fromOffset(9,0)
    playersText.Size = UDim2.new(1,-105,1,0)
    playersText.BackgroundTransparency = 1
    playersText.Text = string.format("Players %d/7 • %s", tonumber(s.playing) or 0, tostring(s.id or "Unknown"))
    playersText.TextSize = 7
    playersText.Font = Enum.Font.GothamBold
    playersText.TextColor3 = Theme.Text
    playersText.TextXAlignment = Enum.TextXAlignment.Left
    playersText.Parent = card

    local join = Instance.new("TextButton")
    join.Position = UDim2.new(1,-88,.5,-11)
    join.Size = UDim2.fromOffset(80,23)
    join.BorderSizePixel = 0
    join.Font = Enum.Font.GothamBold
    join.TextSize = 7
    join.TextColor3 = Color3.new(1,1,1)
    join.Parent = card
    Instance.new("UICorner",join).CornerRadius = UDim.new(0,6)

    local count = tonumber(s.playing) or 0
    local maxP = tonumber(s.maxPlayers) or 7
    if count >= maxP then
        join.Text = "FULL"
        join.BackgroundColor3 = Color3.fromRGB(70,75,85)
        join.AutoButtonColor = false
    else
        join.Text = "JOIN"
        join.BackgroundColor3 = Theme.Main
        join.Activated:Connect(function()
            local ok,err = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId,s.id,player)
            end)
            if not ok then serverStatus.Text = "Join failed: "..tostring(err) end
        end)
    end
end

checkServers.Activated:Connect(function()
    clearServers()
    serverStatus.Text = "Checking available servers..."
    checkServers.Text = "CHECKING..."
    checkServers.Active = false

    local ok,data = pcall(function()
        local raw = game:HttpGet(
            "https://games.roblox.com/v1/games/"..tostring(game.PlaceId)..
            "/servers/Public?sortOrder=Asc&limit=100")
        return HttpService:JSONDecode(raw)
    end)

    checkServers.Active = true
    checkServers.Text = "CHECK SERVERS"

    if not ok or type(data) ~= "table" then
        serverStatus.Text = "Could not load servers. Try CHECK SERVERS again."
        return
    end

    local servers = data.data or {}
    local shown = 0
    for _,s in ipairs(servers) do
        if s.id then addServerCard(s); shown += 1 end
    end

    serverStatus.Text = "Detected "..shown.." server(s)."
    task.defer(function()
        serverList.Size = UDim2.new(1,0,0,serverLayout.AbsoluteContentSize.Y)
    end)
end)

