-- ============ SCRIPT BUTTON BUILDER ============
local function makeScriptButton(name, hubKey)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1,-6,0,34)
    card.BackgroundColor3 = Theme.Card
    card.BorderSizePixel = 0
    card.Parent = scriptList
    Instance.new("UICorner",card).CornerRadius = UDim.new(0,8)

    local label = Instance.new("TextLabel")
    label.Position = UDim2.fromOffset(9,0)
    label.Size = UDim2.new(1,-76,1,0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextSize = 8
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.new(1,1,1)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = card

    local run = Instance.new("TextButton")
    run.Position = UDim2.new(1,-63,.5,-11)
    run.Size = UDim2.fromOffset(57,23)
    run.BackgroundColor3 = Theme.Main
    run.Text = "RUN"
    run.TextSize = 8
    run.Font = Enum.Font.GothamBold
    run.TextColor3 = Color3.new(1,1,1)
    run.BorderSizePixel = 0
    run.Parent = card
    Instance.new("UICorner",run).CornerRadius = UDim.new(0,6)

    run.Activated:Connect(function()
        local fn = Hubs[hubKey]
        if fn then
            local ok,err = pcall(fn)
            if not ok then warn("[Hub Error] "..name..": "..tostring(err)) end
        end
    end)
end

local function clearList()
    for _,v in ipairs(scriptList:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
end

local function showList(list)
    clearList()
    for _,h in ipairs(list) do
        makeScriptButton(h[1],h[2])
    end
    task.wait()
    scriptList.CanvasSize = UDim2.fromOffset(0,layout.AbsoluteContentSize.Y + 8)
end

