local function newPage(class, scrollY)
    local p = Instance.new(class or "Frame")
    p.Size = UDim2.fromScale(1,1)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.Visible = false
    p.ZIndex = 5
    p.Active = true
    p.Parent = content
    if class == "ScrollingFrame" then
        p.ScrollBarThickness = 3
        p.CanvasSize = UDim2.fromOffset(0, scrollY or 400)
        p.Active = true
        p.ZIndex = 5
    end
    return p
end

