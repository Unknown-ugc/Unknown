-- LootLabs Button (Blue, Only one button as requested)
local lootLabsBtn = Instance.new("TextButton")
lootLabsBtn.Size = UDim2.new(0, 200, 0, 40)
lootLabsBtn.Position = UDim2.new(0.5, -100, 0, 310)
lootLabsBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200) -- Blue
lootLabsBtn.Text = "LootLabs"
lootLabsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
lootLabsBtn.Font = Enum.Font.GothamBold
lootLabsBtn.TextSize = 14
lootLabsBtn.Parent = mainFrame

local lootCorner = Instance.new("UICorner")
lootCorner.CornerRadius = UDim.new(0, 8)
lootCorner.Parent = lootLabsBtn

lootLabsBtn.MouseButton1Click:Connect(function()
	lootLabsBtn.Text = "Generating link..."
	lootLabsBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	
	local response = remoteFunction:InvokeServer()
	
	if response.success then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(response.data)
		end)
		
		if success and decoded and decoded.message then
			setclipboard(decoded.message)
			lootLabsBtn.Text = "Link Copied!"
			lootLabsBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- Green success
		else
			lootLabsBtn.Text = "Error parsing link"
			lootLabsBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		end
	else
		lootLabsBtn.Text = "API Error"
		lootLabsBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
	
	task.wait(3)
	lootLabsBtn.Text = "LootLabs"
	lootLabsBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
end)

