local function sendWebhook(cardType, scriptName, details)
	local requestFunction = request or http_request or (syn and syn.request)

	if not requestFunction then
		return false
	end

	local body = HttpService:JSONEncode({
		username = "Report System",
		embeds = {{
			title = cardType,
			color = 5793266,
			fields = {
				{
					name = "Username",
					value = player.Name,
					inline = true
				},
				{
					name = "UserId",
					value = tostring(player.UserId),
					inline = true
				},
				{
					name = "Script Name",
					value = scriptName,
					inline = false
				},
				{
					name = "Details",
					value = details,
					inline = false
				}
			}
		}}
	})

	return pcall(function()
		requestFunction({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = body
		})
	end)
end

