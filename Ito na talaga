-- ============================================
-- SUBMIT BUTTON WITH REMOTE EXECUTION
-- ============================================
local SCRIPT_URL = "https://obfuscatorhub.lol/api/5xN6FToK"

SubmitBtn.MouseButton1Click:Connect(function()
    local entered = KeyInput.Text

    if entered == "" then
        Status.Text = "⚠ Please enter a key."
        Status.TextColor3 = Color3.fromRGB(250, 204, 21)
        return
    end

    if VALID_KEYS[entered] then
        Status.Text = "✓ Key valid! Loading script..."
        Status.TextColor3 = COL_GREEN
        task.wait(0.5)

        -- Attempt to fetch and execute the remote script
        local success, err = pcall(function()
            local response = game:HttpGet(SCRIPT_URL)
            local func, loadErr = loadstring(response)
            
            if not func then
                error("Failed to compile script: " .. tostring(loadErr))
            end
            
            func() -- Execute the script
        end)

        if success then
            Status.Text = "✓ Script loaded successfully!"
            Status.TextColor3 = COL_GREEN
            task.wait(1)
            ScreenGui:Destroy()
        else
            Status.Text = "✕ Execution failed: " .. tostring(err)
            Status.TextColor3 = Color3.fromRGB(248, 113, 113)
        end
    else
        Status.Text = "✕ Invalid or expired key."
        Status.TextColor3 = Color3.fromRGB(248, 113, 113)
        
        -- Shake animation on wrong key
        local orig = Main.Position
        for i = 1, 6 do
            Main.Position = orig + UDim2.new(0, (i % 2 == 0 and 6 or -6), 0, 0)
            task.wait(0.03)
        end
        Main.Position = orig
    end
end)
